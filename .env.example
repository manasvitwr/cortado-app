# Cortado Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Frontend (Vite) - these are prefixed with VITE_ to be exposed to the client
# =============================================================================

# Clerk Publishable Key (get from Clerk Dashboard > API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Clerk Proxy URL (for custom domain deployments, optional)
# VITE_CLERK_PROXY_URL=https://your-domain.com/api/__clerk

# Base URL for the frontend (used for routing)
BASE_URL=/

# Port for Vite dev server (default: 5173)
PORT=5173

# =============================================================================
# Backend (API Server)
# =============================================================================

# Node environment
NODE_ENV=development

# Port for API server (default: 3000)
PORT=3000

# Base URL for API server (used for generating absolute URLs)
BASE_URL=http://localhost:3000

# Clerk Secret Key (get from Clerk Dashboard > API Keys)
CLERK_SECRET_KEY=sk_test_your_key_here

# Clerk Publishable Key (same as frontend, used for proxy middleware)
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

# Database URL for Drizzle ORM
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cortado

# =============================================================================
# Local Object Storage (replaces Replit Object Storage)
# =============================================================================

# Root directory for local file storage
# Defaults to ./local-storage in project root
LOCAL_OBJECT_STORAGE_ROOT=./local-storage

# Comma-separated paths for public object search (for serving public assets)
# Defaults to LOCAL_OBJECT_STORAGE_ROOT/public
PUBLIC_OBJECT_SEARCH_PATHS=./local-storage/public

# Private object directory (for user uploads, profile images, etc.)
# Defaults to LOCAL_OBJECT_STORAGE_ROOT/private
PRIVATE_OBJECT_DIR=./local-storage/private

# =============================================================================
# Optional: YouTube API (for video metadata)
# =============================================================================

# YouTube Data API v3 key (get from Google Cloud Console)
# YOUTUBE_API_KEY=your_youtube_api_key_here